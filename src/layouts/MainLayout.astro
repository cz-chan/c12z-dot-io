---
import { SITE_DEFAULT_CONFIG } from "@/global/site-info.ts";

import Header from "@/layout/header/Header.astro";
import Footer from "@/layout/footer/Footer.astro";

import GTMBody from "@/analytics/GTMBody.astro";
import BottomBar from "@/layout/bottom-bar/BottomBar.tsx";

import BaseHead from "@/seo/BaseHead.astro";

const { lang } = SITE_DEFAULT_CONFIG;
---

<!doctype html>
<html lang={lang}>
	<BaseHead>
		<slot name="head" />
	</BaseHead>
	<body>
		<GTMBody />
		<Header />
		<main>
			<slot />
			<BottomBar client:only="react" />
		</main>
		<Footer />
	</body>
</html>
