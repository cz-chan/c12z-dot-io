import { SITE_404_CONFIG } from "@/global/site-info";
import GTMBody from "@/analytics/GTMBody.astro";

const { lang } = SITE_404_CONFIG;
---

<!doctype html>
<html lang={lang}>
	<BaseHead>
		<slot name="head" />
	</BaseHead>
	<body>
		<GTMBody />
		<main>
			<slot />
		</main>
	</body>
</html>
