---
import { SITE_404_CONFIG } from "@/global/site-info";

import CourageError404Image from "@/assets/images/OpenGraph/404/og-404-error.avif";

import Layout404Error from "@layouts/Layout404Error.astro";

import Page404 from "@/paths/404/components/Page404.astro";
import Error404SEO from "@/seo/404/Error404SEO.astro";
---

<Layout404Error>
	<Error404SEO
		slot="head"
		pageTitle={SITE_404_CONFIG.errorTitle}
		pageDescription={SITE_404_CONFIG.errorDescription}
		pageThumbnail={CourageError404Image.src}
	/>
	<Page404 />
</Layout404Error>
