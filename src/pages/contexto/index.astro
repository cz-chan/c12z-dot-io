---
import styles from "@context-path/components/context.module.css";
import MainLayout from "@/layouts/MainLayout.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { PAGES } from "@/global/pages-info.ts";

import GoBackInTop from "@/ui/go-back-in-top/GoBackInTop.astro";
import Context from "@context-path/components/context.mdx";

const CONTEXT = PAGES.context;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={CONTEXT.title}
		pageDescription={CONTEXT.description}
		ogImage={CONTEXT.ogImage}
		ogImageAlt={CONTEXT.ogImageAlt}
	/>
	<section class={styles.contextPage}>
		<GoBackInTop
			headPage="/"
			title="ir a la home"
		/>
		<article class="lettering">
			<Context />
		</article>
	</section>
</MainLayout>
