---
import { getTopics, type Topic } from "@sources-path/lib/get-topics.ts";

import MainLayout from "@/layouts/MainLayout.astro";
import SourcesSEO from "@sources-path/seo/SourcesSEO.content.astro";
import TopicPage from "@sources-path/components/TopicPage.astro";

interface Props {
	topic: Topic;
}

export async function getStaticPaths() {
	const topics = await getTopics();

	return topics.map((topic) => ({
		params: { id: topic.slug },
		props: { topic },
	}));
}

const { topic } = Astro.props;
---

<MainLayout>
	<SourcesSEO
		slot="head"
		topic={topic}
	/>
	<TopicPage topic={topic} />
</MainLayout>
