---
/**
 * /behavior/fuentes — the drawer index. Just layout + SEO: everything the
 * page does lives in `@sources-path/components/SourcesPage.astro`,
 * which is also the one that reads the content.
 */
import MainLayout from "@/layouts/MainLayout.astro";

import { PAGES } from "@/global/pages-info.ts";

import SourcesPage from "@sources-path/components/SourcesPage.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

const SOURCE_PAGE = PAGES.sources;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={SOURCE_PAGE.title}
		pageDescription={SOURCE_PAGE.description}
		ogImage={SOURCE_PAGE.ogImage}
		ogImageAlt={SOURCE_PAGE.ogImageAlt}
	/>
	<SourcesPage />
</MainLayout>
