---
/**
 * /behavior/fuentes — the drawer index. Just layout + SEO: everything the
 * page does lives in `@sources-path/components/SourcesPage.astro`,
 * which is also the one that reads the content.
 */
import MainLayout from "@/layouts/MainLayout.astro";
import SourcesSEO from "@sources-path/seo/SourcesSEO.content.astro";

import { PAGES } from "@/global/pages-info.ts";

import SourcesPage from "@sources-path/components/SourcesPage.astro";
import { sourcesKeywords } from "@sources-path/seo/sources.keywords.ts";
---

<MainLayout>
	<SourcesSEO
		slot="head"
		pageTitle={PAGES.sources.title}
		pageDescription={PAGES.sources.description}
		ogImageAlt={PAGES.sources.ogImageAlt}
		pageKeywords={sourcesKeywords}
	/>
	<SourcesPage />
</MainLayout>
