---
import { getCollection, type CollectionEntry } from "astro:content";

import MainLayout from "@layouts/MainLayout.astro";
import DesignLawsSEO from "@design-laws-path/seo/DesignLawsSEO.content.astro";
import DesignLawDetail from "@design-laws-path/components/DesignLawDetail.astro";

interface Props {
	entry: CollectionEntry<"designLaws">;
}

export async function getStaticPaths() {
	const designLaws = await getCollection("designLaws");

	return designLaws.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<MainLayout>
	<DesignLawsSEO
		slot="head"
		entry={entry}
	/>
	<DesignLawDetail entry={entry} />
</MainLayout>
