---
import MainLayout from "@/layouts/MainLayout.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { PAGES } from "@/global/pages-info.ts";

import DesignLawsPage from "@design-laws-path/components/DesignLawsPage.astro";
import { designLawsKeywords } from "@design-laws-path/seo/design-laws.keywords.ts";
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={PAGES.design.title}
		pageDescription={PAGES.design.description}
		ogImage={PAGES.design.ogImage}
		ogImageAlt={PAGES.design.ogImageAlt}
		pageKeywords={designLawsKeywords}
	/>
	<DesignLawsPage />
</MainLayout>
