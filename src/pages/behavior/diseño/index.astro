---
import MainLayout from "@layouts/MainLayout.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { PAGES } from "@/global/pages-info";

import DesignPage from "@designs-path/components/DesignPage.astro";
import { designKeywords } from "@designs-path/seo/design.keywords";
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={PAGES.design.title}
		pageDescription={PAGES.design.description}
		ogImage={PAGES.design.ogImage}
		ogImageAlt={PAGES.design.ogImageAlt}
		pageKeywords={designKeywords}
	/>
	<DesignPage />
</MainLayout>
