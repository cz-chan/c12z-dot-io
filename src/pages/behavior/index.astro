---
import MainLayout from "@/layouts/MainLayout.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { PAGES } from "@/global/pages-info.ts";

import BehaviorPage from "@behavior-path/components/BehaviorPage.astro";

const BEHAVIOR_PAGE = PAGES.behavior;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={BEHAVIOR_PAGE.title}
		pageDescription={BEHAVIOR_PAGE.description}
		ogImage={BEHAVIOR_PAGE.ogImage}
		ogImageAlt={BEHAVIOR_PAGE.ogImageAlt}
	/>
	<BehaviorPage />
</MainLayout>
