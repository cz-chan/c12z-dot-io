---
import MainLayout from "@layouts/MainLayout.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { PAGES } from "@/global/pages-info.ts";

import MentalModelsPage from "@mental-models-path/components/MentalModelsPage.astro";
import { mentalModelsKeywords } from "@mental-models-path/seo/mental-models.keywords.ts";
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={PAGES.mentalModel.title}
		pageDescription={PAGES.mentalModel.description}
		ogImage={PAGES.mentalModel.ogImage}
		ogImageAlt={PAGES.mentalModel.ogImageAlt}
		pageKeywords={mentalModelsKeywords}
	/>
	<MentalModelsPage />
</MainLayout>
