---
import styles from "@mental-models-path/components/mental-models.module.css";

import { getCollection, render, type CollectionEntry } from "astro:content";

import MainLayout from "@layouts/MainLayout.astro";

import MentalModelSEO from "@mental-models-path/seo/MentalModelSEO.content.astro";
import PostSources from "@sources-path/components/PostSources.astro";

import GoBackInTop from "@/common/ui/buttons/GoBackInTop.astro";
import WipNotice from "@behavior-path/components/wip/WipNotice.astro";
import TOC from "@/common/ui/toc/Toc.tsx";

interface Props {
	entry: CollectionEntry<"mentalModels">;
}

export async function getStaticPaths() {
	const models = await getCollection("mentalModels");

	return models.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { data, id } = entry;
const { title, publishDate, lastTimeEdited, question, backlog } = data;

const isWip = backlog === "wip";

const { Content, headings } = await render(entry);
---

<MainLayout>
	<MentalModelSEO
		slot="head"
		entry={entry}
	/>
	<section class={styles.model}>
		<TOC
			client:only="react"
			headings={headings}
			title={title}
		/>
		<GoBackInTop
			headPage="/behavior/modelos-mentales"
			title="ir a la página de modelos mentales"
		/>

		<article class={styles.intro}>
			<section class={styles.textAlign}>
				<h1
					transition:name={`${id}-name`}
					class={styles.modelTitle}
				>
					{title}
				</h1>
				<h2 class={styles.modelSubtitle}>{question}</h2>
				<section class={styles.publish}>
					{
						lastTimeEdited && lastTimeEdited !== publishDate ? (
							<>
								<span class={styles.text}>Publicado: {publishDate}</span>
								<span class={styles.text}>Editado: {lastTimeEdited}</span>
							</>
						) : (
							<span class={styles.text}>Publicado: {publishDate}</span>
						)
					}
				</section>
			</section>
			{
				isWip ? (
					<WipNotice />
				) : (
					<section class="lettering">
						<Content />
					</section>
				)
			}
			<PostSources sources={data.sources} />
		</article>
	</section>
</MainLayout>
