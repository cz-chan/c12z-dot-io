---
import { getCollection, type CollectionEntry } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import BehaviorSEO from "@behavior-path/seo/BehaviorSEO.content.astro";
import MentalModelDetail from "@mental-models-path/components/MentalModelDetail.astro";

interface Props {
	entry: CollectionEntry<"mentalModels">;
}

export async function getStaticPaths() {
	const models = await getCollection("mentalModels");

	return models.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<MainLayout>
	<BehaviorSEO
		slot="head"
		entry={entry}
	/>
	<MentalModelDetail entry={entry} />
</MainLayout>
