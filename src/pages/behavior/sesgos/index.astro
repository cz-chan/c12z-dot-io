---
import MainLayout from "@/layouts/MainLayout.astro";
import { PAGES } from "@/global/pages-info.ts";

import { biasKeywords } from "@biases-path/seo/bias.keywords.ts";
import BiasPage from "@biases-path/components/BiasPage.astro";

import PagesSEO from "@/seo/PagesSEO.astro";
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={PAGES.bias.title}
		pageDescription={PAGES.bias.description}
		ogImage={PAGES.bias.ogImage}
		ogImageAlt={PAGES.bias.ogImageAlt}
		pageKeywords={biasKeywords}
	/>
	<BiasPage />
</MainLayout>
