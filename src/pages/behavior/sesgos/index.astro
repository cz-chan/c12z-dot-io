---
import MainLayout from "@/layouts/MainLayout.astro";
import { PAGES } from "@/global/pages-info.ts";

import BiasPage from "@biases-path/components/BiasPage.astro";

import PagesSEO from "@/seo/PagesSEO.astro";

const BIAS_PAGE = PAGES.bias;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={BIAS_PAGE.title}
		pageDescription={BIAS_PAGE.description}
		ogImage={BIAS_PAGE.ogImage}
		ogImageAlt={BIAS_PAGE.ogImageAlt}
	/>
	<BiasPage />
</MainLayout>
