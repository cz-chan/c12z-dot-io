---
import MainLayout from "@layouts/MainLayout.astro";
import { PAGES } from "@/global/pages-info";

import { biasKeywords } from "@/paths/behavior/paths/bias/seo/biasPage.keywords.ts";
import BiasPage from "@/paths/behavior/paths/bias/components/BiasPage.astro";

import PagesSEO from "@/seo/PagesSEO.astro";
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={PAGES.bias.title}
		pageDescription={PAGES.bias.description}
		ogImage={PAGES.bias.ogImage}
		ogImageAlt={PAGES.bias.ogImageAlt}
		pageKeywords={biasKeywords}
	/>
	<BiasPage />
</MainLayout>
