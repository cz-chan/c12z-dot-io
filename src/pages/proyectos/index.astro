---
import MainLayout from "@layouts/MainLayout.astro";

import { PAGES } from "@/global/pages-info.ts";

import ProjectPage from "@projects-path/components/ProjectPage.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { projectsKeywords } from "@projects-path/seo/projects.keywords.ts";
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={PAGES.projects.title}
		pageDescription={PAGES.projects.description}
		ogImage={PAGES.projects.ogImage}
		ogImageAlt={PAGES.projects.ogImageAlt}
		pageKeywords={projectsKeywords}
	/>
	<ProjectPage />
</MainLayout>
