---
import MainLayout from "@/layouts/MainLayout.astro";

import { PAGES } from "@/global/pages-info.ts";

import ProjectPage from "@projects-path/components/ProjectPage.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

const PROJECT_PAGE = PAGES.projects;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={PROJECT_PAGE.title}
		pageDescription={PROJECT_PAGE.description}
		ogImage={PROJECT_PAGE.ogImage}
		ogImageAlt={PROJECT_PAGE.ogImageAlt}
	/>
	<ProjectPage />
</MainLayout>
