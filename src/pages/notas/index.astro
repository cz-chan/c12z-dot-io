---
import MainLayout from "@/layouts/MainLayout.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

import { PAGES } from "@/global/pages-info.ts";

import NotesPage from "@notes-path/components/NotesPage.astro";

const NOTES_PAGE = PAGES.notes;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={NOTES_PAGE.title}
		pageDescription={NOTES_PAGE.description}
		ogImage={NOTES_PAGE.ogImage}
		ogImageAlt={NOTES_PAGE.ogImageAlt}
	/>
	<NotesPage />
</MainLayout>
