---
import { PAGES } from "@/global/pages-info.ts";

import MainLayout from "@/layouts/MainLayout.astro";

import LibraryPage from "@books-path/components/LibraryPage.astro";
import PagesSEO from "@/seo/PagesSEO.astro";

const LIBRARY_PAGE = PAGES.library;
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={LIBRARY_PAGE.title}
		pageDescription={LIBRARY_PAGE.description}
		ogImage={LIBRARY_PAGE.ogImage}
		ogImageAlt={LIBRARY_PAGE.ogImageAlt}
	/>
	<LibraryPage />
</MainLayout>
