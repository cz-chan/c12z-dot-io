---
import { SITE_DEFAULT_CONFIG } from "@/global/site-info";

import MainLayout from "@layouts/MainLayout.astro";

import PagesSEO from "@/seo/PagesSEO.astro";
import type { PageKeywords } from "@/lib/keywords";
import Home from "@home-path/components/Home.astro";

const homeKeywords: PageKeywords = {
	keywords: ["chema ferrandez", "c12z", "cz"],
};
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={SITE_DEFAULT_CONFIG.title}
		pageDescription={SITE_DEFAULT_CONFIG.description}
		pageKeywords={homeKeywords}
	/>
	<Home />
</MainLayout>
