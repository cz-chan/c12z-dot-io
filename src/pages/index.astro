---
import { OG_IMAGE_DEFAULT } from "@/config/pages-info.ts";
import { SITE_DEFAULT_CONFIG } from "@/config/site-info.ts";

import MainLayout from "@/layouts/MainLayout.astro";

import PagesSEO from "@/seo/PagesSEO.astro";
import Home from "@home-path/components/Home.astro";
---

<MainLayout>
	<PagesSEO
		slot="head"
		pageTitle={SITE_DEFAULT_CONFIG.title}
		pageDescription={SITE_DEFAULT_CONFIG.description}
		ogImage={OG_IMAGE_DEFAULT}
	/>
	<Home />
</MainLayout>
