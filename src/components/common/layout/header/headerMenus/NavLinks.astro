---
interface Props {
  href: string;
  text: string;
  currentPath: string;
  customClasses: string;
}

const { href, text, currentPath, customClasses } = Astro.props;
const isActive = currentPath.includes(href);

const navLinksClasses = [
  customClasses,
  isActive ? customClasses : "text-cz-text-headers-dark",
]
  .filter(Boolean)
  .join(" ");
---

<li class="navigation-mobile-link xs:navigation-desktop-link">
  <a class={navLinksClasses} href={href}>{text}</a>
</li>
