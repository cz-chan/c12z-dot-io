{
	mode === "sprite" ? (
		<svg
			style="display: none"
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
		>
			<symbol
				id={SYMBOL_ID}
				viewBox={VIEW_BOX}
				fill="none"
