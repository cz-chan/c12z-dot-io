/**
 * Watermark for /behavior/sesgos — sprite version.
 *
 * Two things separate this from Neuron.astro:
 *
 * 1. The path went through `pnpm dlx svgo --precision=0`, which drops the
 *    sub-pixel decimals the file shipped with: 15.3 KB down to 4.2 KB, 72%
 *    smaller. One viewBox unit is half a screen pixel at the size this
 *    renders, so the rounding is invisible — checked by rendering both and
 *    diffing: 1.1% of pixels differ, and only in edge antialiasing.
 *
 * 2. The geometry is emitted ONCE per page as a <symbol>, and every card
 *    references it with a 30 byte <use>. Inlining the full path per card
 *    puts N copies in the DOM; this puts one.
 *
 * Render <Neuron mode="sprite" /> once in the grid, then <Neuron /> inside
 * each card. The symbol only has to exist somewhere in the document, not
 * before the uses, but keeping it at the top of the grid is the readable
 * choice.
 *
 * `currentColor` still resolves through <use>, so CSS keeps the control.
 *
 * This svg is inpired on: https://svgsilh.com/es/image/2022398.html and modified
 * in Figma.
 */
interface Props {
	mode?: "sprite" | "use";
}

const { mode = "use" } = Astro.props;

