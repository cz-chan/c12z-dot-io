---
import type { PageKeywords } from "@/lib/keywords.ts";

import { SITE_DEFAULT_CONFIG } from "@/global/site-info.ts";
import processKeywords from "@/utils/process-keywords.ts";

interface Props {
	pageTitle: string;
	pageDescription: string;
	ogImage?: string;
	ogImageAlt?: string;
	pageKeywords: PageKeywords;
}

const { pageTitle, pageDescription, ogImage, ogImageAlt, pageKeywords } =
	Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// TODO: CAMBIAR EL OG POR UNO PERSONALIZADO
const ogImageUrl = ogImage
	? new URL(ogImage, Astro.site)
	: new URL("./og-image.webp", Astro.site);
const ogImageUrlAlt = ogImageAlt || pageTitle;

const keywords = processKeywords(pageKeywords).keywords;
---

<title>{pageTitle}</title>
<meta
	content={pageTitle}
	name="title"
/>
<meta
	name="description"
	content={pageDescription}
/>
<meta
	content={SITE_DEFAULT_CONFIG.author}
	name="author"
/>

<link
	rel="canonical"
	href={canonicalURL}
/>

{/* Open Graph / Facebook / WhatsApp */}
<meta
	property="og:title"
	content={pageTitle}
/>
<meta
	property="og:url"
	content={canonicalURL}
/>
<meta
	property="og:description"
	content={pageDescription}
/>
<meta
	content={SITE_DEFAULT_CONFIG.title}
	property="og:site_name"
/>
<meta
	content={SITE_DEFAULT_CONFIG.location}
	property="og:locale"
/>
<meta
	property="og:image"
	content={ogImageUrl}
/>
<meta
	property="og:image:alt"
	content={ogImageUrlAlt}
/>
<meta
	property="og:image:width"
	content="1200"
/>
<meta
	property="og:image:height"
	content="630"
/>
<meta
	property="og:locale"
	content={SITE_DEFAULT_CONFIG.location}
/>

<meta
	property="fb:app_id"
	content="1548538199200247"
/>

{/* SOLO PARA EL MAIN: NO HAY TAGS*/}
<meta
	property="og:type"
	content="article"
/>
{
	keywords &&
		keywords.map((keyword: string) => {
			return (
				<meta
					property="article:tag"
					content={keyword}
				/>
			);
		})
}

{/* Twitter */}
<meta
	name="twitter:title"
	content={pageTitle}
/>
<meta
	name="twitter:description"
	content={pageDescription}
/>
<meta
	name="twitter:image"
	content={ogImageUrl}
/>
<meta
	name="twitter:image:alt"
	content={ogImageUrlAlt}
/>
<meta
	name="twitter:card"
	content="summary_large_image"
/>
<meta
	name="twitter:site"
	content="@cz__chan"
/>
<meta
	name="twitter:creator"
	content="@cz__chan"
/>

{/* RSS auto-discovery */}
{
	/* <link
  href="/rss.xml"
  rel="alternate"
  title={SITE_DEFAULT_CONFIG.title}
  type="application/rss+xml"
/>
*/
}
