---
import styles from "./img-and-cap.module.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	caption: string;
	/** Ancho deseado: número en px o cualquier longitud CSS. La altura va sola. */
	width?: number | string;
}

const { src, alt, caption, width } = Astro.props;

const requested = typeof width === "number" ? `${width}px` : width;

// Nunca escalar por encima del tamaño real: evita el difuminado.
const intrinsic = `${src.width}px`;
---

<div
	class={styles.inc}
	style={{
		"--inc-width": requested ?? "90%",
		"--inc-max": intrinsic,
	}}
>
	<Image
		src={src}
		alt={alt}
		loading="lazy"
		class={styles.theImage}
	/>
	<p class={styles.theCaption}>
		{caption}
	</p>
</div>
