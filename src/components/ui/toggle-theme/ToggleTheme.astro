---
import styles from "./toggle-theme.module.css";
import YingYang from "@/icons/YingYang.astro";
---

<button
	id="theme-toggle"
	class={styles.themeToggle}
	aria-label="Cambiar tema"
>
	<YingYang class={styles.yy} />
</button>

<script>
	import { initToggleTheme } from "./toggle-theme.ts";

	initToggleTheme();
	document.addEventListener("astro:page-load", initToggleTheme);
</script>
