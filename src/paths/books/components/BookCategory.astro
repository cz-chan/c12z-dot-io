---
import styles from "./book.module.css";
import type { CollectionEntry } from "astro:content";
import { BOOKS_CATEGORY_LABELS } from "@/lib/content-categories/books.categories.ts";

interface Props {
	entry: CollectionEntry<"books">;
}

const { entry } = Astro.props;
const { data } = entry;
const { category } = data;
---

<span class={`${styles.bookCategory} ${styles[category]}`}>
	{BOOKS_CATEGORY_LABELS[category]}
</span>
