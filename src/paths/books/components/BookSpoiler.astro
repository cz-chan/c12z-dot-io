---
import styles from "./book.module.css";
import type { CollectionEntry } from "astro:content";

/* 
This component is designed to display the book's abstract, but at the same time, 
it will be optimized for LLMs and the llms.txt file.
*/

interface Props {
	entry: CollectionEntry<"books">;
}

const { entry } = Astro.props;
const { data } = entry;

const { abstract } = data;
---

<details class={styles.bookSpoiler}>
	<summary class={styles.summary}>
		<h2 class={styles.title}>
			Spoiler
			<svg
				fill="none"
				stroke="currentColor"
				class={styles.arrow}
				viewBox="0 0 24 24"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="m19 9-7 7-7-7"
				></path></svg
			>
		</h2>
	</summary>
	<section class={styles.content}>
		<p class={styles.abstract}>{abstract}</p>
	</section>
</details>
