---
import styles from "./home.module.css";
import SocialBlock from "@/icons/social/SocialBlock.astro";
import ShowSortContent from "@home-path/components/ShowSortContent.astro";
import { SITE_VERSION } from "@/global/site-info.ts";
---

<section class={styles.home}>
	<section class={styles.greeting}>
		<p>hi, <strong>cz</strong> here ✌🏽</p>
		<div class={styles.pillSection}>
			<span class={styles.pill}>
				{SITE_VERSION} · main
			</span>
		</div>
	</section>

	<h1 class={styles.intro}>
		I build products. I study why people use them. I make them grow.
	</h1>
	<section>
		<p>
			I’m a Growth Product Engineer, curious about Growth, Behavior & Code, and
			what happens when you put them together. I learn by sharing what I’m
			building, thinking about and figuring out along the way.
		</p>
		<p>
			I’m fascinated by EdTech, ClimateTech and products with Network Effects.
			Outside of work, you’ll probably find me around tattoos, wellness or
			programming and learning for fun.
		</p>
		<p>
			You can check my past works in <a
				class={styles.toWorks}
				target="_blank"
				rel="noopener"
				href="https://works.c12z.io"
				>works.c12z.io</a
			>
		</p>
	</section>
</section>

<section class={styles.socialBlock}>
	<SocialBlock />
	<a
		target="_blank"
		rel="noopener"
		href="https://works.c12z.io/contact"
		class={styles.status}
		><span
			class={styles.statusDot}
			aria-hidden="true"
		></span>open to work</a
	>
</section>

<section class={styles.content}>
	<h2 class={styles.what}>What I write about.</h2>
	<p>Everything in Spanish!</p>

	<ShowSortContent />
</section>
