---
import styles from "@home-path/components/show-content.module.css";
import { updatedSectionLists } from "@home-path/lib/sort-content-in-home.ts";
import SectionLists from "@home-path/components/SectionLists.astro";
---

<section class={styles.list}>
	{
		updatedSectionLists.map(
			({ style, description, href, items, label, totalCount }) => (
				<SectionLists
					href={href}
					style={style}
					label={label}
					description={description}
					items={items}
					totalCount={totalCount}
				/>
			),
		)
	}
</section>
