---
import styles from "./mental-models.module.css";

import { getBehaviorEntries } from "@behavior-path/lib/card/getBehaviorEntries.ts";

import MentalModelsHeader from "./MentalModelsHeader.astro";
import BehaviorGrid from "@behavior-path/components/card/BehaviorGrid.astro";
import { COLLECTION_KEYS } from "@/global/collection-keys.ts";

const models = await getBehaviorEntries("mentalModels");
---

<section class={styles.modelsPage}>
	<MentalModelsHeader />

	{
		models.length > 0 ? (
			<BehaviorGrid
				entries={models}
				section={COLLECTION_KEYS.mentalModels}
			/>
		) : (
			<p class={styles.empty}>
				Todavía no hay ningún modelo mental publicado. Pronto habrá contenido.
				🙂
			</p>
		)
	}
</section>
