---
import { type CollectionEntry } from "astro:content";
import ContentSEO from "@/seo/ContentSEO.astro";
import { convertDateToISO8601 } from "@utils/validating-date.ts";

const { entry } = Astro.props;

const model = entry as CollectionEntry<"designLaws">;
const { data, id } = model;
const { cover, description, keywords, publishDate, lastTimeEdited, title } =
	data;

const postName = `${title} - by cz`;

const postDescription = `${description} - by cz`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// OG dinámico generado en build time (src/pages/og/behavior/diseño/[...id].png.ts)
const ogImageSrc = new URL(`/og/behavior/diseño/${id}.png`, Astro.site);
const ogImageAlt = cover.alt || postName;

const publisDateInISO = convertDateToISO8601(publishDate);
const lastTimeEditedInISO = convertDateToISO8601(
	!lastTimeEdited ? publishDate : lastTimeEdited,
);
---

<ContentSEO
	postName={postName}
	postDescription={postDescription}
	canonicalURL={canonicalURL}
	ogImageSrc={ogImageSrc}
	ogImageAlt={ogImageAlt}
	publisDateInISO={publisDateInISO}
	lastTimeEditedInISO={lastTimeEditedInISO}
	keywords={keywords}
/>
