---
import { getBehaviorEntries } from "@behavior-path/lib/card/get-behavior-entries.ts";

import GoBackInTop from "@/common/ui/buttons/GoBackInTop.astro";
import DesignLawsHeader from "./DesignLawsHeader.astro";
import BehaviorGrid from "@behavior-path/components/card/BehaviorGrid.astro";
import { COLLECTION_KEYS } from "@/global/collection-keys.ts";

const designLaws = await getBehaviorEntries("designLaws");
---

<section>
	<GoBackInTop headPage="/behavior" />
	<DesignLawsHeader />

	<BehaviorGrid
		entries={designLaws}
		section={COLLECTION_KEYS.designLaws}
	/>
</section>
