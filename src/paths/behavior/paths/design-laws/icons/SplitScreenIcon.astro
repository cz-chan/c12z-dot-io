---
import styles from "@behavior-path/icons/section-icon.module.css";
import sides from "@design-laws-path/icons/split-screen-icon.module.css";

interface Props {
	/** Clase del contenedor padre: colocación y visibilidad responsive. */
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={[styles.wrap, className]}>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		stroke="currentColor"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		class={styles.icon}
		role="img"
		viewBox="0 0 48 48"
		><g class={sides.bad}
			><path
				d="m23.9 6.2-17.7.2q-2 .1-1.9 2.1l.3 31.7q.1 1.9 2 1.7l16.7.3 1.5-5.2-2.2-6 2.4-7-2.6-6.9 2.2-5.9ZM5.6 11.6l17.1.3"
			></path><path
				d="m7.4 14.2 11.5-.6.4 7.8-11.5.6Zm10.2 1 1.2 1.2m0-1.2-1.2 1.2"
			></path><path
				d="m10.2 19.4 11.4-.8.5 8-11.4.8Zm10 1.1 1.2 1.2m0-1.2-1.2 1.2"
			></path><path
				d="m6.6 24.8 10.8-.6.4 7.4-10.8.6Zm9.4 1.1 1.1 1.1m0-1.1L16 27m-6.6 7.6 12.4-.6.2 4.4-12.4.6Z"
			></path><path d="m11 36 3.6-.2.1 1.8-3.6.2Z"></path></g
		><g class={sides.good}
			><path
				d="M26.6 6.2h16A1.8 1.8 0 0 1 44.4 8v32.2a1.8 1.8 0 0 1-1.8 1.8H26.1l1.7-5-2.2-6 2.4-7-2.6-7 2.4-5.8Zm1.1 5.9H43"
			></path><circle
				cx="29.6"
				cy="9.3"
				r=".7"
			></circle><circle
				cx="32"
				cy="9.3"
				r=".7"
			></circle><circle
				cx="34.4"
				cy="9.3"
				r=".7"
			></circle><path d="M29.4 16.6h11.4M29.4 20h7.8m-7.8 3.4h10"></path><path
				d="M29.4 31.6h10a1.6 1.6 0 0 1 1.6 1.6v3.4a1.6 1.6 0 0 1-1.6 1.6h-10a1.6 1.6 0 0 1-1.6-1.6v-3.4a1.6 1.6 0 0 1 1.6-1.6"
				class={sides.cta}
			></path></g
		></svg
	>
</div>
