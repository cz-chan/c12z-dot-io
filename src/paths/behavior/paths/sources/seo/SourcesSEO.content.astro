---
import type { Topic } from "@sources-path/lib/get-topics.ts";
import { PAGES } from "@/global/pages-info.ts";
import { convertDateToISO8601 } from "@/utils/validating-date.ts";
import ContentSEO from "@/seo/ContentSEO.astro";

interface Props {
	topic: Topic;
}

const { topic } = Astro.props;
const { name, date, sources } = topic;

const SOURCE_PAGE = PAGES.sources;

const canonical = new URL(Astro.url.pathname, Astro.site);

const pageTitle = `${name}: fuentes consultadas - c12z`;
const pageDescription = `Las ${sources.length} fuentes que he consultado para escribir sobre ${name}.`;

const ogImageSrc = new URL(SOURCE_PAGE.ogImage, Astro.site);
const ogImageAlt = SOURCE_PAGE.ogImageAlt;

const publishDate = convertDateToISO8601(date);

const sourceKeywords = [`Fuentes para aprender sobre ${name}`];
---

<ContentSEO
	slot="head"
	postName={pageTitle}
	postDescription={pageDescription}
	canonicalURL={canonical}
	ogImageSrc={ogImageSrc}
	ogImageAlt={ogImageAlt}
	publisDateInISO={publishDate}
	lastTimeEditedInISO={publishDate}
	keywords={sourceKeywords}
/>
