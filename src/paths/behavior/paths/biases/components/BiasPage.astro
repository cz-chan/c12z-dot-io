---
import styles from "./bias.module.css";

import { getBehaviorEntries } from "@/paths/behavior/lib/card/get-behavior-entries.ts";

import BiasHeader from "./BiasHeader.astro";
import BehaviorGrid from "@behavior-path/components/card/BehaviorGrid.astro";
import GoBackInTop from "@/components/common/ui/buttons/GoBackInTop.astro";
import { COLLECTION_KEYS } from "@/global/collection-keys.ts";

const biases = await getBehaviorEntries("biases");
---

<section class={styles.biasesPage}>
	<GoBackInTop
		headPage="/behavior"
		title="ir a la página de behavior"
	/>
	<section class={styles.thePage}>
		<BiasHeader />

		<h2 class={styles.action}>Pincha. Investiga. Aplica.</h2>
		<BehaviorGrid
			entries={biases}
			section={COLLECTION_KEYS.biases}
		/>
	</section>
</section>
