---
import styles from "./behavior-post.module.css";

import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { categoryStyle } from "@behavior-path/lib/category-colors.ts";
import { categoryLabel } from "@behavior-path/lib/category-label.ts";
import GoBackInTop from "@/ui/go-back-in-top/GoBackInTop.astro";
import WipNotice from "@behavior-path/components/wip/WipNotice.astro";
import PostSources from "@sources-path/components/PostSources.astro";
import TOC from "@/ui/toc/Toc.tsx";

type BehaviorPost =
	| CollectionEntry<"biases">
	| CollectionEntry<"mentalModels">
	| CollectionEntry<"designLaws">;

interface Props {
	entry: BehaviorPost;
	backHref: string;
	backTitle: string;
}

const { entry, backHref, backTitle } = Astro.props;

const section = entry.collection;
const { data, id } = entry;
const { title, question, publishDate, lastTimeEdited, backlog, category } =
	data;

const isWip = backlog === "wip";
const wasEdited = lastTimeEdited && lastTimeEdited !== publishDate;

const { Content, headings } = await render(entry);
---

<section class={styles.post}>
	<TOC
		client:load
		headings={headings}
		title={title}
	/>
	<GoBackInTop
		headPage={backHref}
		title={backTitle}
	/>

	<article class={styles.intro}>
		<section class={styles.textAlign}>
			<h1
				transition:name={`${id}-name`}
				class={styles.postTitle}
			>
				{title}
			</h1>
			<h2 class={styles.postQuestion}>{question}</h2>

			<section class={styles.meta}>
				<p>Categoría:</p>
				<span
					class={styles.pill}
					style={categoryStyle(section, category)}
					>{categoryLabel(section, category)}</span
				>
			</section>

			<section class={styles.publish}>
				<span class={styles.text}>
					Publicado: {isWip ? "por determinar" : publishDate}
				</span>
				{
					!isWip && wasEdited && (
						<span class={styles.text}>Editado: {lastTimeEdited}</span>
					)
				}
			</section>
		</section>

		{
			isWip ? (
				<WipNotice />
			) : (
				<section class="lettering">
					<Content />
				</section>
			)
		}

		<PostSources sources={data.sources} />
	</article>
</section>
