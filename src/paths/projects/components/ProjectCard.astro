---
import styles from "./project.module.css";
import { type CollectionEntry } from "astro:content";

import { ContentRoute } from "@/lib/routes/content-route.ts";

import ProjectCover from "@projects-path/components/ProjectCover.astro";

interface Props {
	entry: CollectionEntry<"projects">;
	index: number;
}

const { entry, index } = Astro.props;
const { data, id } = entry;
const { projectTitle, projectDescription } = data;
const eager = index < 6;

const href = ContentRoute.getLink(entry);
---

<section class={styles.projectCard}>
	<a href={href}>
		<ProjectCover
			entry={entry}
			eager={eager}
		/>
		<h2
			class={styles.title}
			transition:name={`${id}-project-title`}
		>
			{projectTitle}
		</h2>
		<p class={styles.desc}>
			{projectDescription}
		</p>
	</a>
</section>
