---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import styles from "@notes-path/components/notes.module.css";

import GoBackInTop from "@/ui/go-back-in-top/GoBackInTop.astro";

import { convertDateToISO8601 } from "@/utils/validating-date.ts";
import { formatNoteDate } from "@notes-path/lib/format-note-date.ts";
import { NOTES_CATEGORY_LABELS } from "@/lib/content-categories/notes.categories.ts";
import SourceBadges from "@notes-path/components/SourceBadges.astro";

interface Props {
	entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { title, publishDate, sources, category } = entry.data;

const { Content } = await render(entry);
---

<article class={styles.note}>
	<GoBackInTop
		headPage="/notas"
		title="ir a la página de notas"
	/>

	<header class={styles.noteIntro}>
		<p class={styles.meta}>
			<time datetime={convertDateToISO8601(publishDate)}>
				{formatNoteDate(publishDate)}
			</time>
			<span class=`${styles.notesCategory} ${styles[category]}`
				>{NOTES_CATEGORY_LABELS[category]}</span
			>
		</p>
		<h1 transition:name={`${entry.id}-note-title`}>{title}</h1>
	</header>

	<section class="lettering">
		<Content />
	</section>

	{
		sources.length > 0 && (
			<footer class={styles.sourcesFooter}>
				<p class={styles.sourcesLabel}>Fuentes</p>
				<SourceBadges sources={sources} />
			</footer>
		)
	}
</article>
